{
  "name": "streamless",
  "version": "1.0.0",
  "description": "STREAMLESS live streaming studio",
  "main": "main.js",
  "author": "STREAMLESS",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis portable" },
  "dependencies": { "ffmpeg-static": "^5.2.0", "ws": "^8.18.0" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "app.streamless.studio",
    "productName": "STREAMLESS",
    "files": ["main.js", "preload.js", "index.html", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
